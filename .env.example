# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Super admin (one phone): sees statistics, complaints and proposals of all branches
# (read-only) and adds/removes branch admins in the bot.
SUPER_ADMIN_PHONE=+998901112200

# Admin phones per branch (comma-separated, max 3 per branch, format +998XXXXXXXXX).
# An admin sees and manages only their own branch: classes, students, parents,
# teachers, grades, attendance, announcements, complaints and reports.
# Removing a phone here revokes admin access on the next start.
# The super admin can add more branch admins from the bot (max 3 per branch).
ADMIN_PHONES_OLMAZOR=+998901234567
ADMIN_PHONES_SERGELI=+998907654321

# SQLite database file
DB_PATH=parent_bot.db

# Webhook mode (production). Leave WEBHOOK_URL empty for polling mode.
WEBHOOK_URL=
# Random string; Telegram sends it with every webhook request and others are rejected.
WEBHOOK_SECRET=

# HTTP server (webhook mode)
SERVER_PORT=8080
GIN_MODE=debug

# Bearer token for /api/admin/* (users, complaints, stats; ?branch=olmazor|sergeli).
# The API is disabled when empty.
API_TOKEN=
